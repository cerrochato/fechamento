# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). A chave publishable é feita para ficar no app.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 1 = usa dados de exemplo locais (public/demo-seed.json), sem Supabase
NEXT_PUBLIC_DEMO=0
